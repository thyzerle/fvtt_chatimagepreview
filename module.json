{
  "id": "chatimagepreview",
  "title": "Chat Image Preview",
  "description": "This module embeds images from chat messages directly into the chat log. When an embedded image is clicked, it will open in an image viewer.",
  "version": "#{VERSION}#",
  "manifestPlusVersion": "1.2.0",
  "compatibility": {
    "minimum": 13,
    "verified": 14,
    "maximum": 14
  },
  "esmodules": [
    "scripts/module.js"
  ],
  "styles": [
    "styles/module.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "languages/en.json"
    },
    {
      "lang": "pt-BR",
      "name": "Português (Brasil)",
      "path": "languages/pt-BR.json"
    }
  ],
  "authors": [
    {
      "name": "Thyzerle",
      "discord": "thyzerle"
    }
  ],
  "url": "#{URL}#",
  "manifest": "#{MANIFEST}#",
  "download": "#{DOWNLOAD}#",
  "readme": "README.md",
  "changelog": "CHANGELOG.md"
}
